{
  "expo": {
    "name": "Peacock Notes",
    "slug": "Note_app",
    "version": "1.1.7",
    "scheme": "peacocknotes",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "runtimeVersion": "1.1.7",
    "updates": {
      "url": "https://u.expo.dev/7d13650a-3749-415c-bd06-664c7d47e2e0",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F6F2",
      "dark": {
        "image": "./assets/splash-icon.png",
        "backgroundColor": "#121214"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.roy.peacocknotes"
    },
    "android": {
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "versionCode": 19,
      "package": "com.roy.peacocknotes"
    },
    "plugins": [
      [
        "expo-share-intent",
        {
          "androidIntentFilters": [
            "audio/*",
            "image/*",
            "application/pdf"
          ],
          "androidMultiIntentFilters": [
            "audio/*",
            "image/*",
            "application/pdf"
          ],
          "iosActivationRules": {
            "NSExtensionActivationSupportsFileWithMaxCount": 10
          }
        }
      ],
      "./plugins/withShareIntentFilterCleanup",
      "./plugins/withGradleJvmMemory",
      "expo-font"
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "7d13650a-3749-415c-bd06-664c7d47e2e0"
      }
    },
    "owner": "priyanshu22022003"
  }
}
